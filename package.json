{
  "name": "failureship",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Climb the ladder. Manage the narrative. Leave the consequences downstairs.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "play": "node scripts/play.mjs",
    "dev": "vite",
    "build": "vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=moderate",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:e2e && npm run audit && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
